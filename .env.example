# PostgreSQL connection string.
# Local Docker: postgres://ezda:ezda@localhost:5432/ezda
# Supabase/Vercel: use the Supabase Transaction Pooler URI for serverless workloads.
# Migrations are applied automatically by docker compose; outside Docker run `npm run db:migrate`.
DATABASE_URL=postgres://ezda:ezda@localhost:5432/ezda

# Optional: OpenRouteService API key. Without it, MVP uses a straight-line fallback.
ORS_API_KEY=

# Supabase Auth (server-side only).
#
# Local Docker stack: the app reaches GoTrue via the `auth-proxy` (nginx) at
# http://auth-proxy:8000; lib/auth.ts appends /auth/v1/ and the proxy strips it
# before forwarding to GoTrue on :9999 (which serves routes at the root).
# Leave SUPABASE_URL empty to use that built-in default, or override it.
# For non-Docker local dev (GoTrue on the host), set e.g.
#   SUPABASE_URL=http://localhost:8000   # base URL, WITHOUT /auth/v1 suffix
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Local self-hosted Auth tuning (only used by the docker `auth` service).
SUPABASE_POSTGRES_PASSWORD=supabase_admin
SUPABASE_JWT_SECRET=dev-jwt-secret-change-me
SUPABASE_SITE_URL=http://localhost:3000
SUPABASE_MAILER_AUTOCONFIRM=true
SUPABASE_DEBUG_PORT=8000

# Production auth redirect origin. Leave unset for local development.
NEXT_PUBLIC_SITE_URL=
