# PostgreSQL connection string.
# Local Docker: postgres://ezda:ezda@localhost:5432/ezda
# Supabase/Vercel: use the Supabase Transaction Pooler URI for serverless workloads.
# Migrations are applied automatically by docker compose; outside Docker run `npm run db:migrate`.
DATABASE_URL=postgres://ezda:ezda@localhost:5432/ezda

# Optional: OpenRouteService API key. Without it, MVP uses a straight-line fallback.
ORS_API_KEY=
