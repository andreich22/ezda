{
  "name": "ezda",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "tasks:validate": "node scripts/validate-tasks.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "version:check": "node scripts/validate-version.mjs",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "test:e2e:auth": "npx playwright test -c playwright.config.mjs tests/e2e/auth-registration.spec.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^6.10.0",
    "next": "^16.1.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "semver": "^7.8.5"
  }
}
